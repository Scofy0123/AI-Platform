# Local HTTP only. Non-loopback hosts and origins are rejected by configuration validation.
HOST=127.0.0.1
PORT=4310
WEB_ORIGIN=http://127.0.0.1:5173

# These paths are resolved from apps/api when started through `pnpm dev`.
DATABASE_PATH=../../.data/codexplatform.sqlite
RUNTIME_DATA_DIR=../../.data/runtime

# fake = deterministic workflow and four-user scheduler simulation.
# real = pinned Codex App Server plus the startup credential-isolation gate.
RUNTIME_MODE=fake
CODEX_BIN=../../node_modules/.bin/codex

# Required in both runtime modes because every workspace user signs in through Feishu OAuth.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:4310/api/auth/feishu/callback
FEISHU_TENANT_KEY=
# The first OpenID is the only initial administrator and real-mode operator in this MVP.
FEISHU_ADMIN_OPEN_IDS=
# Canonical base64 for exactly 32 random bytes, for example: openssl rand -base64 32
FEISHU_TOKEN_ENCRYPTION_KEY=

# Optional, gated real-smoke inputs. Prefer exporting secrets in the current shell instead of
# persisting user access tokens here.
# REAL_CODEX_E2E=1
# CODEX_E2E_HOME=/absolute/path/to/codexplatform/.data/runtime/codex-accounts/codex-primary
# REAL_FEISHU_E2E=1
# FEISHU_E2E_USER_ACCESS_TOKEN=
# FEISHU_E2E_DOCUMENT_URL=https://example.feishu.cn/wiki/replace-me
# FEISHU_E2E_SEARCH_QUERY=AI
